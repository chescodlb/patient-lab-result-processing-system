{
    "name": "patient-lab-result-processing-system",
    "version": "1.0.0",
    "description": "Healthcare backend microservice for processing patient lab results",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "docker:build": "docker build -t lab-results-system .",
        "docker:run": "docker run -p 3000:3000 -p 6379:6379 lab-results-system"
    },
    "dependencies": {
        "@types/uuid": "^10.0.0",
        "bullmq": "^4.12.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.21.2",
        "ioredis": "^5.3.2",
        "joi": "^17.11.0",
        "uuid": "^9.0.1",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.23",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.19.9",
        "@types/supertest": "^2.0.16",
        "jest": "^29.7.0",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.2.2"
    },
    "keywords": [
        "healthcare",
        "microservice",
        "typescript",
        "bullmq",
        "redis"
    ],
    "author": "Francisco De La Blanca",
    "license": "MIT"
}
